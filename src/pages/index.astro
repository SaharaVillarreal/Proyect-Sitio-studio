              </button>
            </div>
            </div>
            <img src={imgServizio1.src} alt="Immagine del servizio che offre l'azienda" class="w-full lg:w-1/2 rounded-xl h-full object-cover">
          </article>
          <!-- slider #2 -->
          <article class="slide flex flex-col w-full lg:flex-row items-center shrink-0">
            <div class="w-full lg:w-1/2 p-8 flex flex-col">
              <h3 class="text-dark-grey text-2xl lg:text-3xl xl:text-4xl 2xl:text-6xl font-semibold pb-4">Servizio 2</h3>
