</style>
<script>
  const slider = document.querySelector('.slider') as HTMLElement;
  const slides = document.querySelectorAll('.slide');
  const prevBtns = document.querySelectorAll('#prev-btn');
  const nextBtns = document.querySelectorAll('#next-btn');

  let currentIndex = 0;
  const totalSlides = slides.length;

  function updateSlider() {
    if (slider) {
      slider.style.transform = `translateX(-${currentIndex * 100}%)`;
    }
  }

  nextBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentIndex = (currentIndex + 1) % totalSlides;
      updateSlider();
    });
  });

  prevBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      currentIndex = (currentIndex - 1 + totalSlides) % totalSlides;
      updateSlider();
    });
  });

  // Codigo para hacer funcionar el acordion
  // Cuando se haga click en button se vea el contenido del parrafo el accordion-text 
  // btn cambie se vea x cuando esta abierto y un + cuando esta cerrado 
  const accordionBtns = document.querySelectorAll<HTMLButtonElement>('.accordion-btn');

  accordionBtns.forEach((btn) => {
  btn.addEventListener('click', () => {
    const text = btn.nextElementSibling as HTMLElement;
    // Comprobamos si este accordion ya está abierto
    const isOpen = btn.classList.contains('active');

    // Cerramos TODOS los accordions
    accordionBtns.forEach((otherBtn) => {
      const otherText = otherBtn.nextElementSibling as HTMLElement;

      otherBtn.classList.remove('active');
      otherText.classList.remove('active');

      otherBtn.setAttribute('aria-expanded', 'false');
    });

    // Si el que hemos pulsado estaba cerrado,
    // lo abrimos
    if (!isOpen) {
      btn.classList.add('active');
      text.classList.add('active');

      btn.setAttribute('aria-expanded', 'true');
    }
  });
});

</script>
