---
import Main from "../layouts/layout.astro"
import Introduccion from "../components/introducion.astro"
import imgServizio1 from "../assets/img-service.jpg"
import imgServizio2 from "../assets/img-service2.webp"
import imgServizio3 from "../assets/img-service3.jpg"
import imgHero from "../assets/img-hero.jpg"
import { getImage } from 'astro:assets';
const optimizedBackground = await getImage({ src: imgHero, format: 'webp' });
import imgFAQ from "../assets/img-faq.jpg"
const optimizedBackground2 = await getImage({ src: imgFAQ, format: 'webp' });
---

<Main namePagina="Proyect I">
    <section class="relative hero w-full" style={`background-image: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.6)), url('${optimizedBackground.src}');`}>
        <!-- Palabra clave de la solucion que ofrece el cliente a sus compradores -->
        <div class="relative w-full  md:w-3/4 lg:w-3/4 py-15 lg:py-24 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
            <p class="bg-green-yellow w-fit text-lg font-semibold text-dark-grey py-2 px-4 mb-4 rounded-full">Marketing solution</p>
            <h1 class="text-white text-4xl lg:text-5xl xl:text-6xl 2xl:text-8xl font-bold pt-2.5 border-t-2 border-t-white">Inserire in questo spazio uno slogan dell'azienda</h1>
            <p class="text-white pt-2 text-lg lg:text-xl 2xl:text-3xl leading-6">Inserire qui una breve introduzione dell’azienda, la tipologia di prodotti che offre e a chi sono rivolti.</p>
        </div>
    </section>
    <section class="cta w-full py-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
        <div class="w-full flex flex-col lg:flex-row justify-between items-center text-center lg:text-left bg-dark-grey rounded-xl px-2 md:px-8 py-7">
            <p class="text-white text-xl md:text-2xl xl:text-3xl font-semibold pb-2 lg:pb-0">Siamo qui per aiutarti. Contattaci ora!</p>
        <div>
            <a href="/contatti" class="inline-flex mr-2 py-2 px-4 md:px-8 items-center justify-center text-base font-semibold border bg-green-yellow border-green-yellow hover:border-white hover:bg-white rounded-full transition duration-300 bg-lime-300 text-dark-grey">Contatti</a>
            <a href="tel:3739230356" class="inline-flex py-2 px-4 md:px-6 items-center justify-center text-base font-semibold border bg-green-yellow border-green-yellow hover:border-white hover:bg-white rounded-full transition duration-300 bg-lime-300 text-dark-grey">Chiama ora</a>
        </div>
        </div>
    </section>
    <Introduccion/>
    <section class="servizi bg-dark-grey w-full py-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
        <section class="flex flex-col lg:flex-row justify-between lg:items-center pb-12">
          <div class="pr-4 lg:pr-0 w-full lg:w-2/3">
            <h2 class="text-white font-semibold text-3xl lg:text-4xl xl:text-5xl 2xl:text-7xl pb-2">Cosa facciamo</h2>
            <p class="text-white text-lg lg:text-xl 2xl:text-3xl pb-6 lg:pb-0">Inserire qui una breve descrizione dei servizi che saranno elencati nella sezione sottostante.</p>
          </div>
            <a href="/cosa'facciamo" class="inline-flex mr-2 py-4 px-2 md:px-8 items-center justify-center text-base font-semibold border bg-green-yellow border-green-yellow hover:border-white hover:bg-white rounded-full transition duration-300 bg-lime-300 text-dark-grey">Tutti i servizi</a>
        </section>
        <!-- Slider de los servicios -->
        <section class="slider-container bg-green-yellow rounded-xl relative overflow-hidden">
          <div class="slider flex w-auto h-140 lg:h-97 transition-transform duration-500 ease-in-out">
            <!-- slider #1 -->
            <article class="slide flex flex-col w-full lg:flex-row items-center shrink-0">
            <div class="w-full lg:w-1/2 p-8 flex flex-col">
              <h3 class="text-dark-grey text-2xl lg:text-3xl xl:text-4xl 2xl:text-6xl font-semibold pb-4">Servizio 1</h3>
              <p class="text-lg lg:text-xl 2xl:text-3xl leading-6">Lorem ipsum, dolor sit amet consectetur adipisicing elit. Dolores nisi ab consequatur eveniet ad numquam magnam, architecto odit libero illum harum, atque facilis totam vitae quia sequi dolor, nesciunt maxime.</p>
            <div class="arrow flex pt-4">
              <button id="prev-btn" class="cursor-pointer pr-4">
                  <svg width="55px" height="55px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" transform="matrix(-1, 0, 0, 1, 0, 0)"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path d="M6 12H18M18 12L13 7M18 12L13 17" stroke="#1C4E50" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path> </g></svg>  
