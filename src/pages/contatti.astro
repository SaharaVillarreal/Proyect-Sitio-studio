---
import "../styles/stylePropio.css"
import Main from "../layouts/layout.astro"
import NamePagina from "../components/name-page.astro";
import imgContatti from "../assets/img-contact.jpg"
import { getImage } from "astro:assets";
const backgroundImgContact = await getImage({src: imgContatti, format: 'webp'});
---

<Main namePagina="Contatti | Proyect I">
 <NamePagina Description="Inserire qui una breve introduzione della storia dell’azienda, in un massimo di due righe."/>
 <section class="dati-aziendale grid grid-cols-1 lg:grid-cols-3 gap-x-4 gap-y-4 pb-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
    <div class="bg-dark-grey rounded-xl py-8 px-4 w-full flex flex-col items-center">
        <div class="bg-green-yellow p-2 rounded-xl">
        <svg fill="#1C4E50" width="36px" height="36px" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"><path d="M22,5V9L12,13,2,9V5A1,1,0,0,1,3,4H21A1,1,0,0,1,22,5ZM2,11.154V19a1,1,0,0,0,1,1H21a1,1,0,0,0,1-1V11.154l-10,4Z"></path></g></svg>
        </div>
        <p class="text-white text-xl font-semibold py-2">Email</p>
        <a href="" class="text-white text-lg">esempio@infoazienda.co</a>
    </div>
    <div class="bg-dark-grey rounded-xl py-8 px-4 w-full flex flex-col items-center">
        <div class="bg-green-yellow p-2 rounded-xl">
        <svg fill="#1C4E50" height="36px" width="36px" version="1.1" id="Capa_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 612 612" xml:space="preserve"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <g> <g> <path d="M306.001,33.081C109.937,33.077-0.002,94.003,0,165.752v26.524c-0.002,33.671,27.305,60.983,60.993,60.979h85.373 c33.68,0,60.99-27.305,60.99-60.981v-26.522c0-0.613-0.031-1.238-0.052-1.85h197.391c-0.023,0.613-0.051,1.221-0.051,1.85v26.524 c0,33.673,27.31,60.981,60.99,60.981h85.373C584.697,253.26,612,225.952,612,192.276v-26.524 C612.002,94.017,502.065,33.077,306.001,33.081z"></path> <path d="M389.073,262.149l-12.268-3.009v-38.153c0-16.343-13.293-29.638-29.636-29.638h-82.337 c-16.341,0-29.636,13.293-29.636,29.638v38.153l-12.268,3.009c-151.541,37.177-167.9,155.916-167.9,205.241 c0,47.438,10.148,78.208,31.023,94.071c20.193,15.344,50.625,17.459,80.506,17.459h278.888c29.881,0,60.314-2.115,80.508-17.459 c20.874-15.863,31.022-46.633,31.022-94.071C556.973,418.065,540.614,299.325,389.073,262.149z M258.945,504.164 c0,6.403-5.203,11.61-11.625,11.61h-23.108c-6.424,0-11.624-5.205-11.624-11.61v-23.137c0-6.398,5.2-11.61,11.624-11.61h23.108 c6.422,0,11.625,5.212,11.625,11.61V504.164z M258.945,433.931c0,6.401-5.203,11.608-11.625,11.608h-23.108 c-6.424,0-11.624-5.207-11.624-11.608v-23.139c0-6.407,5.2-11.608,11.624-11.608h23.108c6.422,0,11.625,5.203,11.625,11.608 V433.931z M258.945,363.698c0,6.394-5.203,11.608-11.625,11.608h-23.108c-6.424,0-11.624-5.214-11.624-11.608v-23.136 c0-6.41,5.2-11.611,11.624-11.611h23.108c6.422,0,11.625,5.203,11.625,11.611V363.698z M329.178,504.164 c0,6.403-5.201,11.61-11.624,11.61h-23.108c-6.424,0-11.625-5.205-11.625-11.61v-23.137c0-6.398,5.201-11.61,11.625-11.61h23.108 c6.422,0,11.624,5.212,11.624,11.61V504.164z M329.178,433.931c0,6.401-5.201,11.608-11.624,11.608h-23.108 c-6.424,0-11.625-5.207-11.625-11.608v-23.139c0-6.407,5.201-11.608,11.625-11.608h23.108c6.422,0,11.624,5.203,11.624,11.608 V433.931z M329.178,363.698c0,6.394-5.201,11.608-11.624,11.608h-23.108c-6.424,0-11.625-5.214-11.625-11.608v-23.136 c0-6.41,5.201-11.611,11.625-11.611h23.108c6.422,0,11.624,5.203,11.624,11.611V363.698z M399.411,504.164 c0,6.403-5.203,11.61-11.625,11.61h-23.108c-6.422,0-11.624-5.205-11.624-11.61v-23.137c0-6.398,5.201-11.61,11.624-11.61h23.108 c6.422,0,11.625,5.212,11.625,11.61V504.164z M399.411,433.931c0,6.401-5.203,11.608-11.625,11.608h-23.108 c-6.422,0-11.624-5.207-11.624-11.608v-23.139c0-6.407,5.201-11.608,11.624-11.608h23.108c6.422,0,11.625,5.203,11.625,11.608 V433.931z M399.411,363.698c0,6.394-5.203,11.608-11.625,11.608h-23.108c-6.422,0-11.624-5.214-11.624-11.608v-23.136 c0-6.41,5.201-11.611,11.624-11.611h23.108c6.422,0,11.625,5.203,11.625,11.611V363.698z"></path> </g> </g> </g></svg>        
        </div>
        <p class="text-white text-xl font-semibold py-2">Telefono</p>
        <a href="" class="text-white text-lg">3459058899</a>
    </div>
    <div class="bg-dark-grey rounded-xl py-8 px-4 w-full flex flex-col items-center">
        <div class="bg-green-yellow p-2 rounded-xl">
        <svg version="1.0" id="Layer_1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="36px" height="36px" viewBox="0 0 64 64" enable-background="new 0 0 64 64" xml:space="preserve" fill="#1C4E50"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path fill="#1C4E50" d="M32,0C18.746,0,8,10.746,8,24c0,5.219,1.711,10.008,4.555,13.93c0.051,0.094,0.059,0.199,0.117,0.289l16,24 C29.414,63.332,30.664,64,32,64s2.586-0.668,3.328-1.781l16-24c0.059-0.09,0.066-0.195,0.117-0.289C54.289,34.008,56,29.219,56,24 C56,10.746,45.254,0,32,0z M32,32c-4.418,0-8-3.582-8-8s3.582-8,8-8s8,3.582,8,8S36.418,32,32,32z"></path> </g></svg>
        </div>
        <p class="text-white text-xl font-semibold py-2">Indirizzo</p>
        <a href="" class="text-white text-lg">Via roma 2 - Venaria (TO)</a>
    </div>
 </section>
 <section class="lg:pb-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
    <div class="flex flex-col-reverse lg:flex-row border-t border-[#c2c2c260]">
    <div class="flex flex-col lg:pr-4 py-12">
        <p class="text-lg opacity-80">Compila il modulo e sarai ricontattato in poco tempo per ricevere le informazioni che stai cercando.</p>
        <form id="form-contatto" action="" method="post" class="form-contatto flex flex-col py-2">
            <label for="name" class="opacity-80">Nome e cognome*</label>
                <input id="name" name="name" placeholder="Inserisci il tuo nome e cognome" type="text" autocomplete="name" required  class="w-full py-2 px-3 my-2 rounded-full border-2 border-black/40 focus:border-green-yellow focus:outline-none transition-all duration-300">
            <label for="email" class="opacity-80">Email*</label>
                <input id="email" name="email" placeholder="Inserisci la tua email" type="email" autocomplete="on" required  class="w-full py-2 px-3 my-2 rounded-full border-2 border-black/40 focus:border-green-yellow focus:outline-none transition-all duration-300">
            <label for="phone" class="opacity-80">Telefono</label>
                <input id="phone" name="phone" placeholder="Inserisci il tuo numero di telefono" type="tel" autocomplete="tel"  class="w-full py-2 px-3 my-2 rounded-full border-2 border-black/40 focus:border-green-yellow focus:outline-none transition-all duration-300">
            <label for="message" class="opacity-80">Richiesta*</label>
                <textarea name="message" id="message" placeholder="Vorrei avere informazione riguardo a...." required class="w-full h-40 py-2 px-3 my-2 rounded-xl border-2 border-black/40 focus:border-green-yellow focus:outline-none transition-all duration-300"></textarea>    
            <div class="flex items-start">
            <input type="checkbox" name="privacy" id="privacy" required class="accent-dark-grey mr-2 mt-1">
            <span>Dichiaro di aver letto e compreso l’informativa, ai sensi dell’art. 13 del GDPR, e acconsento al trattamento dei miei dati personali finalizzato alla gestione della mia richiesta di informazioni. 
                <button id="open-modal" class="open-modal text-dark-grey cursor-pointer underline">Visualizza privacy policy</button>
            </span>
        </div>
        <button type="submit" class="inline-flex mt-4 mr-4 py-2 px-8 cursor-pointer items-center justify-center text-base font-semibold text-white hover:text-dark-grey border bg-dark-grey border-dark-grey hover:border-white hover:bg-green-yellow rounded-full transition duration-300">Invia richiesta</button>
            </form>
        <div class="modal scrollbar-none fixed inset-0 bg-black/50 items-center justify-center px-8 overflow-y-hidden z-50">
                <div class="modal-interno bg-white min-w-2xs max-w-3xl max-h-[85vh] flex flex-col overflow-hidden rounded-xl text-start">
                    <div class="w-full py-4 px-4 lg:px-6 bg-dark-grey flex justify-between items-center">
                    <h3 class="text-white text-xl font-semibold">Policy & Cookie privacy | PROYECTO I</h3>
                    <button id="close" class="pl-2 cursor-pointer">
                        <svg width="45px" height="45px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <circle cx="12" cy="12" r="10" stroke="#ffffff" stroke-width="1.5"></circle> <path d="M14.5 9.50002L9.5 14.5M9.49998 9.5L14.5 14.5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                    </button>
                    </div>
                    <div class="w-full  py-4 px-8 scrollbar-thin scrollbar-thumb-green-yellow/70 scrollbar-track-green-yellow/20 overflow-y-auto">
                        <p class="text-black text-lg">Contenuto della privacy del sito web <br>
                        //esempio <br>
                        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Id, necessitatibus? Incidunt ducimus, tempore facere aperiam expedita in reprehenderit quos saepe deleniti reiciendis nam consequatur, dolorum, accusantium nostrum esse ab laboriosam!
                        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Id, necessitatibus? Incidunt ducimus, tempore facere aperiam expedita in reprehenderit quos saepe deleniti reiciendis nam consequatur, dolorum, accusantium nostrum esse ab laboriosam!
                        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Id, necessitatibus? Incidunt ducimus, tempore facere aperiam expedita in reprehenderit quos saepe deleniti reiciendis nam consequatur, dolorum, accusantium nostrum esse ab laboriosam!
                        Lorem ipsum dolor sit, amet consectetur adipisicing elit. Id, necessitatibus? Incidunt ducimus, tempore facere aperiam expedita in reprehenderit quos saepe deleniti reiciendis nam consequatur, dolorum, accusantium nostrum esse ab laboriosam!
                        </p>
                    </div>
                </div>
            </div>
    <div id="success-modal" class="hidden fixed inset-0 z-100 bg-black/60 items-center justify-center px-6">
    <div class="bg-white w-full max-w-md rounded-xl overflow-hidden shadow-2xl">
        <div class="bg-green-yellow px-5 py-4 flex justify-between items-center">
            <h3 class="text-dark-grey text-xl font-semibold">Richiesta inviata!</h3>
            <button type="button" id="close-success-modal" class="text-dark-grey cursor-pointer" aria-label="Chiudi modal">
                <svg width="45px" height="45px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <circle cx="12" cy="12" r="10" stroke="#1C4E50" stroke-width="1.5"></circle> <path d="M14.5 9.50002L9.5 14.5M9.49998 9.5L14.5 14.5" stroke="#1C4E50" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
            </button>
        </div>
        <div class="px-6 py-8 text-center">
                <p class="text-dark-grey text-lg mb-4">Grazie <span id="client-name" class="font-bold"></span>!</p>
                <p class="text-dark-grey text-base leading-relaxed">
                La tua richiesta è stata inviata correttamente. <br>
                Ti contatteremo il prima possibile.</p>
                <p class="text-dark-grey/60 text-sm mt-6">Grazie per aver scelto PROYECTO I.</p>
              </div>
            </div> 
       </div>
    </div>
    <div class="img-contatti w-full h-80 lg:h-auto relative bg-cover bg-center rounded-xl" style={`background-image: url('${backgroundImgContact.src}');`}></div>
</div> 
</section>
</Main>
<script src="../scripts/script.js"></script>