---
import "../styles/global.css";
import Menu from "../components/nav.astro";
import { getPageTitle } from "../utils/page-titles";

const namePagina = getPageTitle(Astro.url.pathname);
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/svg+xml" href="/favicon.png" />
	<link rel="icon" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Figtree:ital,wght@0,300..900;1,300..900&family=Google+Sans:ital,opsz,wght@0,17..18,400..700;1,17..18,400..700&display=swap" rel="stylesheet">
    <title>{namePagina} | Proyect I</title>
    <meta name="description" content={`Página ${namePagina} de Proyect I`}>
</head>
<body class="m-0 p-0 overflow-x-hidden">
    <Menu />
    <slot />
</body>
</html>
<style is:global>
    h1, h2, h3{font-family: "Figtree", sans-serif;}
    p, li, a, span, button{font-family: "Google Sans", sans-serif;}
</style>