---
import { getPageTitle } from "../utils/page-titles";

const namePagina = getPageTitle(Astro.url.pathname);

interface Props {
    Description: string
}
const {Description} = Astro.props;
---
<section class="bg-green-yellow flex flex-col items-center w-full mb-12 py-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
    <div class="w-full lg:w-3/4 2xl:w-2/4 flex flex-col items-center text-center">
        <h2 class="font-semibold text-3xl lg:text-4xl xl:text-5xl 2xl:text-7xl pb-2">{namePagina}</h2>
        <p class="text-lg">{Description}</p>
    </div>
</section>