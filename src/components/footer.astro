---
import "../styles/stylePropio.css"
import "../styles/global.css";
import imgFooter from "../assets/waves-lines-footer.png"
import footer from  "../assets/logo-white-actual.png"
---
<section class="w-full bg-dark-grey relative flex flex-col items-center py-12 px-8 md:px-16 lg:px-27 xl:px-34 2xl:px-60">
    <img src={imgFooter.src} alt="" class="absolute bottom-0 left-0">
    <div class="container relative w-full">
        <div class="flex flex-col md:flex-wrap lg:flex-row py-12 text-white">
        <div class="logo w-full lg:w-2/4">
            <img src={footer.src} alt="" class="w-52 mb-4">
        </div>
        <div class="menu-footer w-full lg:w-1/4 pb-2 lg:pb-0">
            <h4 class="text-xl font-semibold">Link rapidi</h4>
            <ul>
                <li class="py-2 hover:text-green-yellow hover:translate-x-2 transition-all duration-300 cursor-pointer"><a href="/">Home</a></li>
                <li class="py-2 hover:text-green-yellow hover:translate-x-2 transition-all duration-300 cursor-pointer"><a href="/chi-siamo">Chi siamo</a></li>
                <li class="py-2 hover:text-green-yellow hover:translate-x-2 transition-all duration-300 cursor-pointer"><a href="/cosa-facciamo">Cosa facciamo</a></li>
                <li class="py-2 hover:text-green-yellow hover:translate-x-2 transition-all duration-300 cursor-pointer"><a href="/contatti">Contatti</a></li>
            </ul>
        </div>
        <div class="info-contatti w-full lg:w-1/4">
            <h4 class="text-xl font-semibold">Informazione</h4>
            <ul class="inline">
                <li class="flex items-center py-2">
                    <i class="pr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-geo-alt" viewBox="0 0 16 16">
                            <path d="M12.166 8.94c-.524 1.062-1.234 2.12-1.96 3.07A32 32 0 0 1 8 14.58a32 32 0 0 1-2.206-2.57c-.726-.95-1.436-2.008-1.96-3.07C3.304 7.867 3 6.862 3 6a5 5 0 0 1 10 0c0 .862-.305 1.867-.834 2.94M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10"/>
                            <path d="M8 8a2 2 0 1 1 0-4 2 2 0 0 1 0 4m0 1a3 3 0 1 0 0-6 3 3 0 0 0 0 6"/>
                        </svg>
                    </i>Via roma 2 - Venaria (TO)</li>
                <li class="flex items-center py-2">
                    <i class="pr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-telephone" viewBox="0 0 16 16">
                            <path d="M3.654 1.328a.678.678 0 0 0-1.015-.063L1.605 2.3c-.483.484-.661 1.169-.45 1.77a17.6 17.6 0 0 0 4.168 6.608 17.6 17.6 0 0 0 6.608 4.168c.601.211 1.286.033 1.77-.45l1.034-1.034a.678.678 0 0 0-.063-1.015l-2.307-1.794a.68.68 0 0 0-.58-.122l-2.19.547a1.75 1.75 0 0 1-1.657-.459L5.482 8.062a1.75 1.75 0 0 1-.46-1.657l.548-2.19a.68.68 0 0 0-.122-.58zM1.884.511a1.745 1.745 0 0 1 2.612.163L6.29 2.98c.329.423.445.974.315 1.494l-.547 2.19a.68.68 0 0 0 .178.643l2.457 2.457a.68.68 0 0 0 .644.178l2.189-.547a1.75 1.75 0 0 1 1.494.315l2.306 1.794c.829.645.905 1.87.163 2.611l-1.034 1.034c-.74.74-1.846 1.065-2.877.702a18.6 18.6 0 0 1-7.01-4.42 18.6 18.6 0 0 1-4.42-7.009c-.362-1.03-.037-2.137.703-2.877z"/>
                        </svg>
                    </i>+39 345 905 8899</li>
                <li class="flex items-center py-2">
                    <i class="pr-2">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" class="bi bi-envelope" viewBox="0 0 16 16">
                            <path d="M0 4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm2-1a1 1 0 0 0-1 1v.217l7 4.2 7-4.2V4a1 1 0 0 0-1-1zm13 2.383-4.708 2.825L15 11.105zm-.034 6.876-5.64-3.471L8 9.583l-1.326-.795-5.64 3.47A1 1 0 0 0 2 13h12a1 1 0 0 0 .966-.741M1 11.105l4.708-2.897L1 5.383z"/>
                        </svg>
                    </i>esempio@infoazienda.co</li>
            </ul>
        </div>
    </div>
    <div class="relative privacy flex flex-col lg:flex-row pt-12 lg:pt-0 text-white border-t border-t-[#f5f5f560] lg:border-0">
        <div class="w-full lg:w-1/2">
            <button>© Copyright 2025 Flow. All rights reserved.</button>
        </div>
        <div class="w-full lg:w-1/2 text-left lg:text-end">
            <button id="open-modal" type="submit" class="open-modal hover:text-green-yellow transition-all duration-300 cursor-pointer">Policy privacy | Cookie privacy</button>
            <div class="modal scrollbar-none fixed inset-0 bg-black/50 items-center justify-center px-8 overflow-y-hidden z-50">
                <div class="modal-interno bg-white min-w-2xs max-w-3xl max-h-[85vh] flex flex-col overflow-hidden rounded-xl text-start">
                    <div class="w-full py-4 px-4 lg:px-6 bg-dark-grey flex justify-between items-center">
                    <h3 class="text-white text-xl font-semibold">Policy & Cookie privacy | PROYECTO I</h3>
                    <button id="close" class="pl-2 cursor-pointer">
                        <svg width="45px" height="45px" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <circle cx="12" cy="12" r="10" stroke="#ffffff" stroke-width="1.5"></circle> <path d="M14.5 9.50002L9.5 14.5M9.49998 9.5L14.5 14.5" stroke="#ffffff" stroke-width="1.5" stroke-linecap="round"></path> </g></svg>
                    </button>
                    </div>
                    <div class="w-full py-4 px-8 scrollbar-thin scrollbar-thumb-green-yellow/70 scrollbar-track-green-yellow/20 overflow-y-auto">
                        <p class="text-black text-lg">Contenuto della privacy del sito web
